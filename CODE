#include <Wire.h>
#include <Servo.h>
#include "DFRobot_BNO055.h"

// =====================================================
// BNO055
// =====================================================

typedef DFRobot_BNO055_IIC BNO;
BNO bno(&Wire, 0x28);


// =====================================================
// SERVO
// =====================================================

Servo steering;

const byte SERVO_PIN = 11;

// These WILL need final mechanical calibration
const int SERVO_CENTER = 90;

const int SERVO_LEFT_MAX  = 45;
const int SERVO_RIGHT_MAX = 125;

// Limit used during normal straight driving
const int SERVO_LEFT_STRAIGHT  = 62;
const int SERVO_RIGHT_STRAIGHT = 118;


// =====================================================
// MOTOR
// =====================================================

const byte IN1 = 5;
const byte IN2 = 6;

const int STRAIGHT_SPEED = 150;
const int TURN_SPEED     = 150;
const int FINISH_SPEED   = 140;


// =====================================================
// ULTRASONIC PINS
// =====================================================

// Front
const byte TRIG_F = 3;
const byte ECHO_F = 2;

// Right
const byte TRIG_R = 8;
const byte ECHO_R = 7;

// Left
const byte TRIG_L = 10;
const byte ECHO_L = 9;


// =====================================================
// START BUTTON
// =====================================================

const byte START_BUTTON = 12;


// =====================================================
// STATES
// =====================================================

enum RobotState
{
  WAITING,
  STRAIGHT,
  TURNING,
  FINISHING,
  STOPPED,
  ERROR_STOP
};

RobotState state = WAITING;


// =====================================================
// TURN DIRECTION
// =====================================================

enum TurnDirection
{
  UNKNOWN,
  LEFT,
  RIGHT
};

TurnDirection routeDirection = UNKNOWN;


// =====================================================
// HEADING
// =====================================================

float initialHeading = 0;
float targetHeading = 0;


// =====================================================
// CORNER / LAP VARIABLES
// =====================================================

byte cornerCount = 0;

const byte TOTAL_CORNERS = 12;

unsigned long lastCornerFinished = 0;
unsigned long turnStartTime = 0;


// Prevent immediate re-detection after a turn
const unsigned long CORNER_COOLDOWN = 650;


// =====================================================
// FINISH VARIABLES
// =====================================================

unsigned long finishingStartTime = 0;

bool finishWallsFound = false;
unsigned long finishWallsFoundTime = 0;

// Robot must move far enough out of final corner
const unsigned long FINISH_EXTRA_DRIVE = 450;

// Emergency maximum
const unsigned long FINISH_TIMEOUT = 2200;


// =====================================================
// ULTRASONIC VALUES
// =====================================================

float distF = 200;
float distL = 200;
float distR = 200;

float filteredL = 200;
float filteredR = 200;
float filteredF = 200;


// =====================================================
// SENSOR SETTINGS
// =====================================================

// Higher than any normal side-wall distance.
//
// Official corridor maximum is roughly 100 cm,
// so 125 cm represents "wall disappeared".
const float OPEN_DISTANCE = 125.0;

// Ignore stupid values
const float MAX_DISTANCE = 220.0;

// Front emergency protection
const float FRONT_DANGER = 28.0;


// =====================================================
// OPENING DEBOUNCE
// =====================================================

byte leftOpenCounter  = 0;
byte rightOpenCounter = 0;

const byte OPEN_CONFIRMATIONS = 2;


// =====================================================
// STRAIGHT CONTROL
// =====================================================

// Heading correction
float HEADING_KP = 1.50;
float HEADING_KD = 0.08;

// Wall centering correction
float WALL_KP = 0.45;

float previousHeadingError = 0;

unsigned long lastControlTime = 0;


// =====================================================
// TURN SETTINGS
// =====================================================

const float TURN_ANGLE = 90.0;

const float TURN_TOLERANCE = 4.0;

const unsigned long TURN_TIMEOUT = 3000;


// =====================================================
// DEBUG
// =====================================================

#define DEBUG_ROBOT 1


// =====================================================
// ANGLE NORMALIZATION
// =====================================================

float angleDiff(float target, float current)
{
  float difference = target - current;

  while (difference > 180.0)
    difference -= 360.0;

  while (difference < -180.0)
    difference += 360.0;

  return difference;
}


// =====================================================
// NORMALIZE HEADING
// =====================================================

float normalizeHeading(float angle)
{
  while (angle >= 360.0)
    angle -= 360.0;

  while (angle < 0.0)
    angle += 360.0;

  return angle;
}


// =====================================================
// GET BNO HEADING
// =====================================================

float getHeading()
{
  BNO::sEulAnalog_t euler = bno.getEul();

  return normalizeHeading(euler.head);
}


// =====================================================
// MOTOR
// =====================================================

void setMotorSpeed(int motorSpeed)
{
  motorSpeed = constrain(motorSpeed, 0, 255);

  analogWrite(IN1, motorSpeed);
  digitalWrite(IN2, LOW);
}


void stopMotor()
{
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
}


// =====================================================
// ULTRASONIC READ
// =====================================================

float readUltrasonicCM(byte trigPin, byte echoPin)
{
  digitalWrite(trigPin, LOW);
  delayMicroseconds(3);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);


  // 15000 us gives roughly 2.5 m maximum.
  unsigned long duration =
    pulseIn(echoPin, HIGH, 15000UL);


  // No echo
  if (duration == 0)
  {
    return MAX_DISTANCE;
  }


  float distance = duration * 0.0343 / 2.0;


  if (distance > MAX_DISTANCE)
    distance = MAX_DISTANCE;

  if (distance < 2)
    distance = 2;


  return distance;
}


// =====================================================
// READ ALL ULTRASONICS
// =====================================================

void updateDistances()
{
  // Don't fire all three at exactly the same time.
  // This reduces ultrasonic cross-talk.

  distF = readUltrasonicCM(TRIG_F, ECHO_F);

  delay(3);

  distR = readUltrasonicCM(TRIG_R, ECHO_R);

  delay(3);

  distL = readUltrasonicCM(TRIG_L, ECHO_L);


  // -------------------------------------------------
  // Low-pass filtering
  // -------------------------------------------------

  const float alpha = 0.35;

  filteredF =
    (alpha * distF) +
    ((1.0 - alpha) * filteredF);

  filteredR =
    (alpha * distR) +
    ((1.0 - alpha) * filteredR);

  filteredL =
    (alpha * distL) +
    ((1.0 - alpha) * filteredL);
}


// =====================================================
// WALL VALIDITY
// =====================================================

bool leftWallPresent()
{
  return distL < OPEN_DISTANCE;
}


bool rightWallPresent()
{
  return distR < OPEN_DISTANCE;
}


bool bothWallsPresent()
{
  return leftWallPresent() &&
         rightWallPresent();
}


// =====================================================
// RESET STRAIGHT CONTROLLER
// =====================================================

void resetStraightController()
{
  previousHeadingError = 0;

  lastControlTime = millis();
}


// =====================================================
// DRIVE STRAIGHT
// =====================================================

void driveStraight(int motorSpeed)
{
  float heading = getHeading();


  // -------------------------------------------------
  // DT
  // -------------------------------------------------

  unsigned long now = millis();

  float dt =
    (now - lastControlTime) / 1000.0;

  lastControlTime = now;


  if (dt <= 0 || dt > 0.2)
    dt = 0.02;


  // -------------------------------------------------
  // HEADING ERROR
  // -------------------------------------------------

  float headingError =
    angleDiff(
      targetHeading,
      heading
    );


  float derivative =
    (headingError - previousHeadingError)
    / dt;

  previousHeadingError = headingError;


  // -------------------------------------------------
  // WALL CENTERING
  // -------------------------------------------------

  float wallError = 0;


  // Only use wall centering when BOTH walls actually
  // exist.
  //
  // This is critical at corners because the inside
  // ultrasonic suddenly sees empty space.

  if (bothWallsPresent())
  {
    // Example:
    //
    // closer to right wall:
    //
    // right = 10
    // left  = 30
    //
    // 10 - 30 = -20
    //
    // negative steering correction -> LEFT
    //
    // exactly what we want.

    wallError =
      filteredR - filteredL;
  }


  // -------------------------------------------------
  // CONTROLLER
  // -------------------------------------------------

  float correction =
      HEADING_KP * headingError
    + HEADING_KD * derivative
    + WALL_KP    * wallError;


  int servoAngle =
    SERVO_CENTER + correction;


  servoAngle =
    constrain(
      servoAngle,
      SERVO_LEFT_STRAIGHT,
      SERVO_RIGHT_STRAIGHT
    );


  steering.write(servoAngle);

  setMotorSpeed(motorSpeed);
}


// =====================================================
// CHECK CORNER OPENING
// =====================================================

bool detectRightOpening()
{
  if (distR > OPEN_DISTANCE)
  {
    if (rightOpenCounter < 10)
      rightOpenCounter++;
  }
  else
  {
    rightOpenCounter = 0;
  }


  return
    rightOpenCounter >=
    OPEN_CONFIRMATIONS;
}


bool detectLeftOpening()
{
  if (distL > OPEN_DISTANCE)
  {
    if (leftOpenCounter < 10)
      leftOpenCounter++;
  }
  else
  {
    leftOpenCounter = 0;
  }


  return
    leftOpenCounter >=
    OPEN_CONFIRMATIONS;
}


// =====================================================
// START TURN
// =====================================================

void startTurn(TurnDirection direction)
{
  if (direction == RIGHT)
  {
    targetHeading =
      normalizeHeading(
        targetHeading + TURN_ANGLE
      );
  }

  else if (direction == LEFT)
  {
    targetHeading =
      normalizeHeading(
        targetHeading - TURN_ANGLE
      );
  }


  turnStartTime = millis();

  leftOpenCounter  = 0;
  rightOpenCounter = 0;

  state = TURNING;
}


// =====================================================
// UPDATE TURN
// =====================================================

void updateTurn()
{
  float heading = getHeading();

  float error =
    angleDiff(
      targetHeading,
      heading
    );


  float remaining =
    abs(error);


  // -------------------------------------------------
  // TURN COMPLETE
  // -------------------------------------------------

  if (remaining <= TURN_TOLERANCE)
  {
    steering.write(SERVO_CENTER);

    cornerCount++;

    lastCornerFinished = millis();

    resetStraightController();


#if DEBUG_ROBOT

    Serial.print("Corner completed: ");
    Serial.println(cornerCount);

#endif


    // Three laps = 12 corners
    if (cornerCount >= TOTAL_CORNERS)
    {
      finishingStartTime = millis();

      finishWallsFound = false;

      state = FINISHING;
    }
    else
    {
      state = STRAIGHT;
    }


    return;
  }


  // -------------------------------------------------
  // TURN TIMEOUT
  // -------------------------------------------------

  if (
    millis() - turnStartTime >
    TURN_TIMEOUT
  )
  {
    stopMotor();

    steering.write(SERVO_CENTER);

    state = ERROR_STOP;

    return;
  }


  // -------------------------------------------------
  // PROGRESSIVE STEERING
  // -------------------------------------------------

  int servoAngle;


  if (routeDirection == RIGHT)
  {
    // Strong steering early in turn
    if (remaining > 35)
    {
      servoAngle =
        SERVO_RIGHT_MAX;
    }

    // Reduce steering near target to reduce overshoot
    else if (remaining > 15)
    {
      servoAngle =
        (SERVO_RIGHT_MAX +
         SERVO_CENTER) / 2;
    }

    else
    {
      servoAngle =
        SERVO_CENTER + 12;
    }
  }

  else
  {
    if (remaining > 35)
    {
      servoAngle =
        SERVO_LEFT_MAX;
    }

    else if (remaining > 15)
    {
      servoAngle =
        (SERVO_LEFT_MAX +
         SERVO_CENTER) / 2;
    }

    else
    {
      servoAngle =
        SERVO_CENTER - 12;
    }
  }


  steering.write(servoAngle);

  setMotorSpeed(TURN_SPEED);
}


// =====================================================
// FINISH THREE LAPS
// =====================================================

void updateFinishing()
{
  driveStraight(FINISH_SPEED);


  unsigned long now = millis();


  // -------------------------------------------------
  // Find normal straight corridor again
  // -------------------------------------------------

  if (bothWallsPresent())
  {
    if (!finishWallsFound)
    {
      finishWallsFound = true;

      finishWallsFoundTime = now;
    }
  }


  // Once both walls are clearly visible again,
  // continue a little farther so the entire 25 cm
  // vehicle is completely inside the straight section.

  if (
    finishWallsFound &&
    now - finishWallsFoundTime >=
    FINISH_EXTRA_DRIVE
  )
  {
    stopMotor();

    steering.write(SERVO_CENTER);

    state = STOPPED;

    return;
  }


  // Emergency fallback.
  //
  // We do NOT want the car accidentally entering
  // corner 13.

  if (
    now - finishingStartTime >
    FINISH_TIMEOUT
  )
  {
    stopMotor();

    steering.write(SERVO_CENTER);

    state = STOPPED;
  }
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);


  // -------------------------------------------------
  // Motor
  // -------------------------------------------------

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  stopMotor();


  // -------------------------------------------------
  // Ultrasonics
  // -------------------------------------------------

  pinMode(TRIG_F, OUTPUT);
  pinMode(ECHO_F, INPUT);

  pinMode(TRIG_R, OUTPUT);
  pinMode(ECHO_R, INPUT);

  pinMode(TRIG_L, OUTPUT);
  pinMode(ECHO_L, INPUT);


  // -------------------------------------------------
  // Start button
  // -------------------------------------------------

  pinMode(
    START_BUTTON,
    INPUT_PULLUP
  );


  // -------------------------------------------------
  // Servo
  // -------------------------------------------------

  steering.attach(SERVO_PIN);

  steering.write(SERVO_CENTER);


  // -------------------------------------------------
  // BNO055
  // -------------------------------------------------

  Wire.begin();

  bno.reset();


  while (
    bno.begin() !=
    BNO::eStatusOK
  )
  {
#if DEBUG_ROBOT
    Serial.println(
      "BNO055 not detected"
    );
#endif

    delay(500);
  }


  delay(1000);


  // Prime ultrasonic filters

  updateDistances();

  filteredF = distF;
  filteredL = distL;
  filteredR = distR;


#if DEBUG_ROBOT

  Serial.println(
    "Robot ready. Press START."
  );

#endif
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  updateDistances();


  // =================================================
  // WAITING
  // =================================================

  if (state == WAITING)
  {
    stopMotor();

    steering.write(SERVO_CENTER);


    if (
      digitalRead(START_BUTTON) ==
      LOW
    )
    {
      delay(40); // debounce


      if (
        digitalRead(START_BUTTON) ==
        LOW
      )
      {
        initialHeading =
          getHeading();

        targetHeading =
          initialHeading;


        cornerCount = 0;

        routeDirection =
          UNKNOWN;


        resetStraightController();


        lastCornerFinished =
          millis();


        state = STRAIGHT;


#if DEBUG_ROBOT

        Serial.print(
          "START heading: "
        );

        Serial.println(
          initialHeading
        );

#endif


        // Wait for button release
        while (
          digitalRead(
            START_BUTTON
          ) == LOW
        )
        {
          delay(5);
        }
      }
    }


    return;
  }


  // =================================================
  // STRAIGHT
  // =================================================

  if (state == STRAIGHT)
  {
    driveStraight(
      STRAIGHT_SPEED
    );


    // Do not detect another corner immediately after
    // completing a turn.

    if (
      millis() -
      lastCornerFinished <
      CORNER_COOLDOWN
    )
    {
      return;
    }


    // -----------------------------------------------
    // FIRST CORNER
    // -----------------------------------------------
    //
    // We don't yet know whether this run is CW or CCW.
    //
    // The side where the inner wall disappears tells
    // us the turning direction.

    if (
      routeDirection ==
      UNKNOWN
    )
    {
      bool rightOpen =
        detectRightOpening();

      bool leftOpen =
        detectLeftOpening();


      if (
        rightOpen &&
        !leftOpen
      )
      {
        routeDirection =
          RIGHT;

#if DEBUG_ROBOT

        Serial.println(
          "ROUTE = RIGHT / CW"
        );

#endif

        startTurn(RIGHT);

        return;
      }


      if (
        leftOpen &&
        !rightOpen
      )
      {
        routeDirection =
          LEFT;

#if DEBUG_ROBOT

        Serial.println(
          "ROUTE = LEFT / CCW"
        );

#endif

        startTurn(LEFT);

        return;
      }
    }


    // -----------------------------------------------
    // REMAINING RIGHT TURNS
    // -----------------------------------------------

    else if (
      routeDirection ==
      RIGHT
    )
    {
      if (detectRightOpening())
      {
        startTurn(RIGHT);

        return;
      }
    }


    // -----------------------------------------------
    // REMAINING LEFT TURNS
    // -----------------------------------------------

    else if (
      routeDirection ==
      LEFT
    )
    {
      if (detectLeftOpening())
      {
        startTurn(LEFT);

        return;
      }
    }


    // -----------------------------------------------
    // FRONT SAFETY
    // -----------------------------------------------

    if (filteredF < FRONT_DANGER)
    {
      // If the corner opening detector somehow missed
      // the corner, use the already-known direction.

      if (
        routeDirection ==
        RIGHT
      )
      {
        startTurn(RIGHT);
      }

      else if (
        routeDirection ==
        LEFT
      )
      {
        startTurn(LEFT);
      }
    }


    return;
  }


  // =================================================
  // TURNING
  // =================================================

  if (state == TURNING)
  {
    updateTurn();

    return;
  }


  // =================================================
  // FINISHING
  // =================================================

  if (state == FINISHING)
  {
    updateFinishing();

    return;
  }


  // =================================================
  // STOPPED
  // =================================================

  if (state == STOPPED)
  {
    stopMotor();

    steering.write(
      SERVO_CENTER
    );

    return;
  }


  // =================================================
  // ERROR
  // =================================================

  if (state == ERROR_STOP)
  {
    stopMotor();

    steering.write(
      SERVO_CENTER
    );

    return;
  }
}
