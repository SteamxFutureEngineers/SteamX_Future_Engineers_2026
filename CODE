// Prints which way the servo is steering right now and why, throttled so it
// doesn't flood the port.
void printSteering(float error, float wallOffset, int angle) {
  static unsigned long lastPrintMs = 0;
  unsigned long now = millis();
  if (now - lastPrintMs < 200) return;
  lastPrintMs = now;

  const char *dir = (angle == SERVO_CENTER) ? "STRAIGHT"
                  : (((SERVO_RIGHT > SERVO_LEFT) == (angle > SERVO_CENTER)) ? "RIGHT" : "LEFT");
  Serial.print(F("Steer: ")); Serial.print(dir);
  Serial.print(F("  (heading err: ")); Serial.print(error, 1);
  Serial.print(F(" deg, wall offset: ")); Serial.print(wallOffset, 1);
  Serial.print(F(" deg, trim: ")); Serial.print(servoTrim, 1);
  Serial.println(F(")"));
}

// Proportional servo steering: yaw error -> servo angle, no deadband needed
// since the servo holds an exact position instead of bang-bang steering.
// wallOffset shifts the target heading slightly to keep us between walls
// (callers pass the global centerOffset, or 0 during turns).
void steerToHeading(float wallOffset) {
  float error = (targetYaw + wallOffset) - yaw;   // +error = need to turn CCW (left)

  // learn the standing steering bias, but only while roughly on-heading
  // (integrating during a 90-deg turn would wind the trim way up)
  static unsigned long lastTrimMicros = 0;
  unsigned long nowUs = micros();
  float dt = (nowUs - lastTrimMicros) / 1000000.0;
  lastTrimMicros = nowUs;
  if (dt < 0.5 && fabs(error) < 20.0) {   // dt guard: skip after long gaps (reverse phases etc.)
    servoTrim = constrain(servoTrim + TRIM_RATE * error * dt, -TRIM_LIMIT, TRIM_LIMIT);
  }

  // positive error = need to steer LEFT. Which numeric direction that is on
  // this car's linkage is derived from the calibration constants, so the
  // polarity can never contradict them (a flipped sign here = positive
  // feedback = the heading hold runs away and spirals into a wall).
  int towardLeft = (SERVO_LEFT > SERVO_RIGHT) ? +1 : -1;
  int angle = SERVO_CENTER + towardLeft * (int)(error * SERVO_KP + servoTrim);
  angle = constrain(angle, min(SERVO_LEFT, SERVO_RIGHT), max(SERVO_LEFT, SERVO_RIGHT));

  bool steeringRight = (SERVO_RIGHT > SERVO_LEFT) ? (angle > SERVO_CENTER)
                                                  : (angle < SERVO_CENTER);
  digitalWrite(LED_BUILTIN, steeringRight ? HIGH : LOW);  // LED on = steering right

  printSteering(error, wallOffset, angle);
  steeringServo.write(angle);
}

// Wall centering offset (deg) from the side ultrasonics. Positive = steer
// left. Steers toward the middle when both walls are visible, and actively
// away from a single wall that's dangerously close. Returns 0 when a side is
// open (corner area) so it never fights the corner logic.
float wallCenteringOffset(long left, long right) {
  bool leftNear  = left  < WALL_NEAR_CM;
  bool rightNear = right < WALL_NEAR_CM;

  float offset = 0;
  if (leftNear && rightNear) {
    // both walls visible: drift toward the middle (right closer -> positive -> left)
    offset = WALL_CENTER_GAIN * (float)(left - right) * 0.5;
  } else if (rightNear && right < WALL_PUSH_CM) {
    offset = WALL_CENTER_GAIN * (float)(WALL_PUSH_CM - right) * 2.0;   // push LEFT, away from right wall
  } else if (leftNear && left < WALL_PUSH_CM) {
    offset = -WALL_CENTER_GAIN * (float)(WALL_PUSH_CM - left) * 2.0;   // push RIGHT, away from left wall
  }
  return constrain(offset, -MAX_CENTER_OFFSET, MAX_CENTER_OFFSET);
}

#if OBSTACLE_MODE
// Ask the HuskyLens for blocks and keep the closest red/green one (biggest =
// nearest). Sets the block* globals; blockActive true only if it's close
// enough (big enough) to steer around.
void readHuskyBlock() {
  blockColorId = 0; blockX = 160; blockSize = 0;
  int best = 0;
  if (huskylens.request()) {
    while (huskylens.available()) {
      HUSKYLENSResult r = huskylens.read();
      if (r.ID != HUSKY_ID_RED && r.ID != HUSKY_ID_GREEN) continue;
      int sz = max(r.width, r.height);
      if (sz > best) { best = sz; blockColorId = r.ID; blockX = r.xCenter; blockSize = sz; }
    }
  }
  blockActive = (blockColorId != 0 && blockSize >= BLOCK_MIN_SIZE);
}

// Heading offset (deg, positive = steer left) that drives the block's image
// toward the correct frame edge, so it passes on the rule's side of the car.
float blockAvoidanceOffset() {
  bool isRed    = (blockColorId == HUSKY_ID_RED);
  bool keepLeft = (isRed == (RED_KEEPS_LEFT != 0));   // red keeps left iff RED_KEEPS_LEFT
  int  xTarget  = keepLeft ? BLOCK_X_LEFT : BLOCK_X_RIGHT;
  float off = -BLOCK_GAIN * (float)(blockX - xTarget);
  off = constrain(off, -BLOCK_MAX_OFFSET, BLOCK_MAX_OFFSET);

  // don't let the P-loop ease back to ~0 just because it reached the target
  // x position - keep committing to the dodge side while the block is active
  float minOff = keepLeft ? -BLOCK_MIN_OFFSET : BLOCK_MIN_OFFSET;
  if (keepLeft) off = min(off, minOff);   // more negative = further left commit
  else          off = max(off, minOff);   // more positive = further right commit

  return off;
}
#endif

// =====================================================
//                       SETUP
// =====================================================
void setup() {
  // grab the hardware reset cause FIRST (brown-out / power-on / external),
  // before anything else can disturb it
  uint8_t resetFlags = MCUSR;
  MCUSR = 0;

  Serial.begin(115200);

  // if a run was in progress when we rebooted, stamp a BOOT marker (with the
  // reset cause + current Vcc) into its log - this is the brown-out evidence
  logBootMarker(resetFlags);

  // replay the previous run's flight log (opening the serial monitor resets
  // the board and lands here; the delay lets the monitor reconnect in time)
  delay(1000);
  Serial.print(F("This boot's reset cause: ")); printResetCause(resetFlags); Serial.println();
  logDump();

  pinMode(IN3, OUTPUT);  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(FRONT_TRIG, OUTPUT); pinMode(FRONT_ECHO, INPUT);
  pinMode(RIGHT_TRIG, OUTPUT); pinMode(RIGHT_ECHO, INPUT);
  pinMode(LEFT_TRIG,  OUTPUT); pinMode(LEFT_ECHO,  INPUT);

  pinMode(START_BUTTON, INPUT_PULLUP);
  pinMode(LED_BUILTIN, OUTPUT);

  steeringServo.attach(SERVO_PIN);
  centerSteering();
  stopDrive();

#if OBSTACLE_MODE
  Serial2.begin(9600);
  // the HuskyLens boots slower than the Mega, so one early begin() can miss it -
  // retry for ~3s before giving up
  bool huskyOK = false;
  for (int i = 0; i < 10 && !huskyOK; i++) {
    huskyOK = huskylens.begin(Serial2);
    if (!huskyOK) delay(300);
  }
  if (!huskyOK)
    Serial.println(F("HuskyLens NOT found - check 5V power, T->17 R->16, and Serial 9600 mode (NOT I2C)"));
  else
    Serial.println(F("HuskyLens ready (expects Color Recognition mode, red+green learned)"));
#endif

  Serial.println("Calibrating gyro - DO NOT MOVE the vehicle...");
  gyroInit();
  Serial.println("Gyro ready. Waiting for start button.");
}

// =====================================================
//                        LOOP
// =====================================================
void loop() {
  updateYaw();   // keep heading updated EVERY loop, in every state

#if DEBUG_ALWAYS_READ_US
  // debug: live readings in every state so the log always moves.
  // (~450ms per pass -> gyro loop is slow; DO NOT drive/turn like this)
  #if OBSTACLE_MODE
  readHuskyBlock();   // so the bench log shows block detection when you wave one in front
  #endif
  readUltrasonics(lastFront, lastRight, lastLeft);
#else
  // competition: only ping the ultrasonics in states that use them for a
  // decision (3 samples x 3 sensors = ~100-200ms per pass). Steering keeps
  // running during the pass via gyroSteerFor; other states just re-print
  // the last known readings.
  if (state == STRAIGHT_START || state == FIND_DIRECTION || state == RUN) {
#if OBSTACLE_MODE
    readHuskyBlock();
    if (blockActive) {
      // a close block steers us (overrides wall centering); remember it so we
      // can keep clearing it for a moment after the camera loses it up close
      centerOffset = blockAvoidanceOffset();
      lastBlockOffset = centerOffset;
      lastBlockMs = millis();
    }
#endif
    readUltrasonics(lastFront, lastRight, lastLeft);
#if OBSTACLE_MODE
    if (!blockActive) {
  unsigned long sinceBlock = millis() - lastBlockMs;
  if (sinceBlock < BLOCK_HOLD_MS) {
    centerOffset = lastBlockOffset;                    // still committed to the dodge line
  } else if (sinceBlock < BLOCK_HOLD_MS + BLOCK_RETURN_MS) {
    float t = (float)(sinceBlock - BLOCK_HOLD_MS) / (float)BLOCK_RETURN_MS;  // 0 -> 1
    centerOffset = lastBlockOffset * (1.0 - t);         // linearly fade the offset back to 0
  } else {
    centerOffset = wallCenteringOffset(lastLeft, lastRight);  // back to normal wall following
  }
}
#else
    centerOffset = wallCenteringOffset(lastLeft, lastRight);
#endif
  }
#endif
  printUltrasonics(lastFront, lastRight, lastLeft);   // keep logging every loop, in every state

  // flight recorder: capture telemetry to EEPROM while the run is active
  if (state != WAIT_START && state != DONE) logTelemetry();

  switch (state) {

    // ---------- rule 9.11: wait for the single start button ----------
    case WAIT_START:
      #if TESTING_MODE
        // bench testing only: skip the button, start right after calibration
        yaw = 0; targetYaw = 0;
        lastGyroMicros = micros();
        straightStartMs = millis();
        logStartRun();                        // fresh log, or continue an interrupted run's log
        state = STRAIGHT_START;
        Serial.println("GO (TESTING_MODE - button skipped)");
      #else
        if (digitalRead(START_BUTTON) == LOW) {
          delay(50);                            // debounce
          yaw = 0; targetYaw = 0;               // this heading = "straight"
          lastGyroMicros = micros();
          straightStartMs = millis();
          logStartRun();                        // fresh log, or continue an interrupted run's log
          state = STRAIGHT_START;
          Serial.println("GO");
        }
      #endif
      break;

    // ---------- drive straight for STRAIGHT_START_MS, no corner detection ----------
    // Gets the car cleanly out of the start section before we start looking
    // for the first corner (avoids false triggers while still near the start
    // walls, and gives the gyro heading-hold a clean straight reference run).
    case STRAIGHT_START:
      driveForward();
      steerToHeading(centerOffset);             // gyro hold + wall centering

      if (millis() - straightStartMs >= STRAIGHT_START_MS) {
        Serial.println(F("Straight-start done -> looking for first corner"));
        state = FIND_DIRECTION;
      }
      break;

    // ---------- drive straight until a side opens up (first corner) ----------
    case FIND_DIRECTION: {
      driveForward();
      steerToHeading(centerOffset);             // gyro hold + wall centering

      // absolute threshold: the corridor is never wider than ~100cm, so a
      // side past SIDE_OPEN_CM can only be the corner opening
      bool leftOpened  = lastLeft  >= SIDE_OPEN_CM;
      bool rightOpened = lastRight >= SIDE_OPEN_CM;

      // a block right ahead reads as a near "front wall" on the ultrasonic -
      // don't let it fake a corner (the HuskyLens knows it's a block)
      bool blockAhead = false;
#if OBSTACLE_MODE
      blockAhead = blockActive;
#endif

      // every trigger must hold CORNER_CONFIRM_READS loops in a row (a single
      // angled-wall no-echo reads as 999 = "open" - don't trust one sample)
      if (leftOpened || rightOpened)                  sideOpenStreak++;  else sideOpenStreak  = 0;
      if (lastFront < FRONT_CORNER_CM && !blockAhead) frontCloseStreak++; else frontCloseStreak = 0;

      // remember which side has shown open at any point on this approach, in
      // case its reading flickers below the threshold right at trigger time.
      // Only while a front wall is actually coming up - a lone glitch in the
      // middle of a straight must not be memorized as "the open side".
      if (lastFront < 150) {
        if (leftOpened && (!rightOpened || lastLeft >= lastRight)) seenOpenDir = +1;
        else if (rightOpened)                                      seenOpenDir = -1;
      }

      bool sideTrigger  = sideOpenStreak   >= CORNER_CONFIRM_READS;
      bool frontTrigger = frontCloseStreak >= CORNER_CONFIRM_READS;

      if (sideTrigger || frontTrigger) {
        Serial.print(F("Corner: left ")); Serial.print(lastLeft);
        Serial.print(F("cm  right ")); Serial.print(lastRight);
        Serial.print(F("cm  front ")); Serial.print(lastFront); Serial.println(F("cm"));

        // Direction comes from what the sensors say NOW, not from which streak
        // completed first (flight log: front streak won the race while the
        // left sensor was reading 138cm of open road - the closer-side
        // fallback then sent us the wrong way).
        if (leftOpened || rightOpened) {
          // a side is open: that's the road. If somehow both, take the wider one.
          if (leftOpened && (!rightOpened || lastLeft >= lastRight)) {
            turnDirection = +1;                 // CCW, left turns
            Serial.println(F("Direction: COUNTER-CLOCKWISE (left open)"));
          } else {
            turnDirection = -1;                 // CW, right turns
            Serial.println(F("Direction: CLOCKWISE (right open)"));
          }
        } else if (seenOpenDir != 0) {
          // no side open right now, but one showed open earlier on this
          // approach - trust that over the closer-side guess
          turnDirection = seenOpenDir;
          Serial.print(F("Direction: side opened earlier on approach -> "));
          Serial.println(seenOpenDir > 0 ? F("COUNTER-CLOCKWISE") : F("CLOCKWISE"));
        } else {
          // neither side ever opened (narrow section, front cue only): the
          // ring always bends toward its CENTER = toward the inner wall =
          // the side that reads CLOSER.
          turnDirection = (lastLeft <= lastRight) ? +1 : -1;
          Serial.println(F("Direction: front cue - turning toward the closer (inner) side"));
        }
        targetYaw += 90.0 * turnDirection;
        cornerCount = 1;
        sideOpenStreak = 0; frontCloseStreak = 0;
        sideRearmed = false;                    // must see the side closed before the next corner counts
        turnStartMs = millis(); reverseUntilMs = 0;
        centerOffset = 0;                       // no wall centering mid-turn
        state = TURNING;
      }
      break;
    }

    // ---------- normal straight driving between corners ----------
    case RUN: {
      driveForward();
      steerToHeading(centerOffset);             // gyro hold + wall centering

      // two corner cues, both confirmed over CORNER_CONFIRM_READS loops and
      // gated by the post-turn cooldown:
      //  - the side we turn toward (inner wall) reads open, or
      //  - the front wall is close (narrow sections, where the side cue is late)
      long sideNow = (turnDirection == +1) ? lastLeft : lastRight;
      bool cooldownOver = (millis() - lastTurnDoneMs) >= CORNER_COOLDOWN_MS;

      // a block right ahead reads as a near "front wall" - don't let it fake a corner
      bool blockAhead = false;
#if OBSTACLE_MODE
      blockAhead = blockActive;
#endif

      // re-arm: the watched side must be seen CLOSED (new section's inner wall
      // beside us) before its opening can count as the NEXT corner
      if (sideNow < SIDE_OPEN_CM) sideRearmed = true;

      if (sideNow >= SIDE_OPEN_CM && cooldownOver && sideRearmed)     sideOpenStreak++;  else sideOpenStreak  = 0;
      if (lastFront < FRONT_CORNER_CM && cooldownOver && !blockAhead) frontCloseStreak++; else frontCloseStreak = 0;

      if (sideOpenStreak >= CORNER_CONFIRM_READS || frontCloseStreak >= CORNER_CONFIRM_READS) {
        cornerCount++;
        Serial.print(F("Corner ")); Serial.print(cornerCount);
        Serial.print((sideOpenStreak >= CORNER_CONFIRM_READS) ? F(" (side opened)") : F(" (front wall)"));
        Serial.print(F("  side ")); Serial.print(sideNow); Serial.print(F("cm  front "));
        Serial.print(lastFront); Serial.println(F("cm"));
        targetYaw += 90.0 * turnDirection;
        sideOpenStreak = 0; frontCloseStreak = 0;
        sideRearmed = false;                    // must see the side closed before the next corner counts
        turnStartMs = millis(); reverseUntilMs = 0;
        centerOffset = 0;                       // no wall centering mid-turn
        state = TURNING;
      }
      break;
    }

    // ---------- executing a 90-degree corner ----------
    case TURNING: {
      unsigned long now = millis();

      if (now < reverseUntilMs) {
        // nose was pinned against a wall: back straight up to make room
        centerSteering();
        driveBackward();
      } else if (now - turnStartMs > TURN_TIMEOUT_MS) {
        // yaw hasn't reached the target in time = we're pushing a wall,
        // not turning. Reverse for a moment, then resume the turn.
        Serial.println(F("TURNING stuck - reversing to free the nose"));
        reverseUntilMs = now + TURN_REVERSE_MS;
        turnStartMs    = now + TURN_REVERSE_MS;  // restart the timeout after backing up
      } else {
        driveForward();
        steerToHeading(0);                      // no wall centering mid-turn
      }

      float error = targetYaw - yaw;
      if (abs(error) < TURN_DONE_ERROR) {
        lastTurnDoneMs = millis();              // start the corner cooldown
        if (cornerCount >= TOTAL_CORNERS) {
          state = FINISH;                       // last corner done -> enter finish
        } else {
          state = RUN;
        }
      }
      break;
    }

    // ---------- 3 laps done: drive to the middle of the start section, stop ----------
    // Distance-based: entering the section, the far wall is ~2-2.5m ahead;
    // front < FINISH_FRONT_CM (2 reads in a row) = mid-section. The timeout is
    // only a backstop (sensor failure / pinned against a wall).
    case FINISH: {
      unsigned long t0 = millis();
      int frontNearStreak = 0;
      while (millis() - t0 < FINISH_TIMEOUT_MS) {
        updateYaw();
        readUltrasonics(lastFront, lastRight, lastLeft);   // update globals so the log stays live
        printUltrasonics(lastFront, lastRight, lastLeft);
        logTelemetry();

        if (lastFront < FINISH_FRONT_CM) frontNearStreak++; else frontNearStreak = 0;
        if (frontNearStreak >= CORNER_CONFIRM_READS) break;   // mid-section reached

        centerOffset = wallCenteringOffset(lastLeft, lastRight);
        driveForward();
        steerToHeading(centerOffset);           // gyro hold + wall centering
      }
      stopDrive();
      centerSteering();
      logRunFinished();                       // run completed normally - next GO starts a fresh log
      Serial.println("FINISHED - 3 laps");
      state = DONE;
      break;
    }

    // ---------- stay stopped (rule: no movement after the stop) ----------
    case DONE:
      stopDrive();
      centerSteering();
      break;
  }
}
