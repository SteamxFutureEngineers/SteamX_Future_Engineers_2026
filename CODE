#include <Wire.h>
#include <Servo.h>
#include "DFRobot_BNO055.h"
#include <Ultrasonic.h>

typedef DFRobot_BNO055_IIC BNO;
BNO bno(&Wire, 0x28);

Servo steering;

#define IN1 5
#define IN2 6

Ultrasonic ultrasonicR(8, 7);
Ultrasonic ultrasonicF(3, 2);
Ultrasonic ultrasonicL(10, 9);


// ================================
// STATES
// ================================
byte start = 0;
byte turnR = 1;
byte turnL = 2;
byte CW = 3;
byte CCW = 4;
byte finish = 5;

byte count = 0;
byte state = start;


// ================================
// PID CONSTANTS
// ================================
float Kp = 2.5;
float Ki = 0.000000011;
float Kd = 1.0;


// ================================
// PID VARIABLES
// ================================
float error = 0;
float lastError = 0;
float integral = 0;
float derivative = 0;


// ================================
// HEADING VARIABLES
// ================================
float startHeading;
float targetHeading;

// Accumulated heading target
float turnTarget;


// ================================
// ANGLE DIFFERENCE
// ================================
float angleDiff(float target, float current) {

  float diff = target - current;

  while (diff > 180)
    diff -= 360;

  while (diff < -180)
    diff += 360;

  return diff;
}


// ================================
// STOP MOTOR
// ================================
void stopMotor() {

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
}


// ================================
// FORWARD MOTOR
// ================================
void forwardMotor() {

  analogWrite(IN1, 200);
  digitalWrite(IN2, LOW);
}


// ================================
// DRIVE FORWARD WITH PID
// ================================
void driveForward() {

  forwardMotor();

  BNO::sEulAnalog_t euler = bno.getEul();

  float heading = euler.head;

  // Compare actual heading with accumulated target
  error = angleDiff(targetHeading, heading);

  integral += error;

  derivative = error - lastError;

  float pid =
    (Kp * error) +
    (Ki * integral) +
    (Kd * derivative);

  lastError = error;

  int servoAngle = constrain(90 + pid, 60, 120);

  steering.write(servoAngle);

  delay(10);
}


// ================================
// TURN LEFT 90 DEGREES
// ================================
void turnLeft90() {

  // =================================
  // ACCUMULATE LEFT TURN
  // =================================
  turnTarget -= 90;

  // Keep between 0 and 360
  if (turnTarget < 0)
    turnTarget += 360;

  targetHeading = turnTarget;


  steering.write(45);
  forwardMotor();

  unsigned long turnStart = millis();

  while (true) {

    BNO::sEulAnalog_t euler = bno.getEul();

    float heading = euler.head;

    float turnError = angleDiff(targetHeading, heading);


    // ================================
    // TURN COMPLETE
    // ================================
    if (abs(turnError) <= 5.0) {

      stopMotor();
      steering.write(90);

      // DO NOT change targetHeading here

      lastError = 0;
      integral = 0;
      derivative = 0;

      delay(300);

      return;
    }


    // ================================
    // SAFETY TIMEOUT
    // ================================
    if (millis() - turnStart > 3000) {

      stopMotor();
      steering.write(90);

      // Keep accumulated target

      lastError = 0;
      integral = 0;
      derivative = 0;

      delay(300);

      return;
    }

    delay(100);
  }
}


// ================================
// TURN RIGHT 90 DEGREES
// ================================
void turnRight90() {

  // =================================
  // ACCUMULATE RIGHT TURN
  // =================================
  turnTarget += 90;

  // Keep between 0 and 360
  if (turnTarget >= 360)
    turnTarget -= 360;

  targetHeading = turnTarget;


  steering.write(125);
  forwardMotor();

  unsigned long turnStart = millis();

  while (true) {

    BNO::sEulAnalog_t euler = bno.getEul();

    float heading = euler.head;

    float turnError = angleDiff(targetHeading, heading);


    // ================================
    // TURN COMPLETE
    // ================================
    if (abs(turnError) <= 5.0) {

      stopMotor();
      steering.write(90);

      // DO NOT reset targetHeading

      lastError = 0;
      integral = 0;
      derivative = 0;

      delay(300);

      return;
    }


    // ================================
    // SAFETY TIMEOUT
    // ================================
    if (millis() - turnStart > 3000) {

      stopMotor();
      steering.write(90);

      // Keep accumulated target

      lastError = 0;
      integral = 0;
      derivative = 0;

      delay(300);

      return;
    }

    delay(10);
  }
}


// ================================
// SETUP
// ================================
void setup() {

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  steering.attach(11);
  steering.write(90);

  Wire.begin();

  bno.reset();

  while (bno.begin() != BNO::eStatusOK) {
    // Wait for BNO055
  }


  // ================================
  // GET INITIAL HEADING
  // ================================
  BNO::sEulAnalog_t euler = bno.getEul();

  startHeading = euler.head;

  // Initial forward direction
  targetHeading = startHeading;

  // Start accumulated target
  turnTarget = startHeading;
}


// ================================
// MOVE AFTER TURN
// ================================
void moveAfterTurn() {

  steering.write(90);

  // Move forward a little
  // without changing heading target
  forwardMotor();

  delay(200);

  stopMotor();

  delay(10);

  // Keep accumulated targetHeading
  lastError = 0;
  integral = 0;
  derivative = 0;
}


unsigned long startTime = 0;


// ================================
// LOOP
// ================================
void loop() {


  // =========================
  // START / DRIVE FORWARD
  // =========================
  if (state == start) {

    driveForward();

    int rightDistance = ultrasonicR.read();
    int leftDistance = ultrasonicL.read();


    // =========================
    // RIGHT DETECTION
    // =========================
    if (rightDistance > 130) {

      state = turnR;
    }


    // =========================
    // LEFT DETECTION
    // =========================
    if (leftDistance > 130) {

      state = turnL;
    }
  }


  // =========================
  // RIGHT TURN
  // =========================
  if (state == turnR) {

    turnRight90();

    count++;

    moveAfterTurn();

    state = CW;

    return;
  }


  // =========================
  // CLOCKWISE
  // =========================
  if (state == CW) {

    if (count >= 12) {

      startTime = millis();

      state = finish;

      return;
    }

    driveForward();

    int rightDistance = ultrasonicR.read();

    if (rightDistance > 130) {

      state = turnR;
    }
  }


  // =========================
  // LEFT TURN
  // =========================
  if (state == turnL) {

    turnLeft90();

    count++;

    moveAfterTurn();

    state = CCW;

    return;
  }


  // =========================
  // COUNTER-CLOCKWISE
  // =========================
  if (state == CCW) {

    if (count >= 12) {

      startTime = millis();

      state = finish;

      return;
    }

    driveForward();

    int leftDistance = ultrasonicL.read();

    if (leftDistance > 130) {

      state = turnL;
    }
  }


  // =========================
  // FINISH
  // =========================
  if (state == finish) {

    while (millis() - startTime < 2000) {

      driveForward();
    }

    stopMotor();

    steering.write(90);

    while (true) {
    }
  }
}
