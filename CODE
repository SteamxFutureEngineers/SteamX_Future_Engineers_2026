// =====================================================
//              EEPROM FLIGHT RECORDER
// =====================================================
// Logs telemetry into the Mega's 4KB EEPROM during the run (EEPROM survives
// power-off and reset), so a real untethered run can be debugged afterwards:
// plug in USB, open the serial monitor, and the whole last run prints as CSV
// at boot. One record = 13 bytes -> 314 records; at one per 300ms ~= 90 s
// (plenty for a block-encounter test; raise LOG_PERIOD_MS for a full 3-lap run).
// Every record includes the 5V rail voltage, and an unexpected reset mid-run
// (brown-out!) appends a BOOT marker with the hardware reset cause - together
// these prove/disprove battery problems.
// Layout: [0]=magic  [1..2]=record count  [3]=run-active flag  [4...]=records
// Record: [0..1]=t(0.1s)  [2]=state  [3]=F  [4]=R  [5]=L  [6..7]=yaw(0.1deg)
//         [8]=Vcc(0.05V)  [9]=blk(0/1R/2G)  [10]=blockX/2  [11]=blockSize  [12]=steerOffset(int8 deg)
#define LOG_MAGIC      0xA6      // bump this whenever the record format changes - it auto-invalidates
                                 // any older-format log still in EEPROM so a stale dump can't misread
#define LOG_ACTIVE_ADDR 3        // 1 = a run is in progress (cleared when FINISH completes)
#define LOG_DATA_ADDR  4
#define LOG_REC_SIZE   13
#define LOG_MAX_RECS   ((4096 - LOG_DATA_ADDR) / LOG_REC_SIZE)   // 314
#define LOG_PERIOD_MS  300
#define LOG_BOOT_STATE 99        // state value marking "the board rebooted here"

uint16_t logCount = 0;           // records written this run
unsigned long logT0 = 0;         // millis() at GO (timestamps are relative to it)

// Vcc (the 5V rail) measured against the internal 1.1V bandgap - no wiring
// needed. A brown-out shows as this sagging right before the log cuts off.
long readVccMillivolts() {
  ADMUX = _BV(REFS0) | 0x1E;     // AVcc reference, input = 1.1V bandgap
  delay(2);                      // let the reference settle
  ADCSRA |= _BV(ADSC);
  while (ADCSRA & _BV(ADSC));
  return 1125300L / ADC;         // 1.1V * 1023 * 1000 / reading
}

uint8_t packVcc() { return (uint8_t)constrain(readVccMillivolts() / 50, 0, 255); }  // 0.05V units

void logClear() {
  logCount = 0;
  logT0 = millis();
  EEPROM.update(0, LOG_MAGIC);
  EEPROM.put(1, logCount);
}

// Called at GO. If the previous run never finished (flag still set = the
// board reset mid-run), KEEP that log and append to it, so the evidence and
// the BOOT marker survive a TESTING_MODE auto-restart instead of being wiped.
void logStartRun() {
  if (EEPROM.read(0) == LOG_MAGIC && EEPROM.read(LOG_ACTIVE_ADDR) == 1) {
    EEPROM.get(1, logCount);
    if (logCount > LOG_MAX_RECS) logCount = LOG_MAX_RECS;
    logT0 = millis();
    Serial.println(F("Previous run never finished - continuing its flight log"));
  } else {
    logClear();
  }
  EEPROM.update(LOG_ACTIVE_ADDR, 1);
}

void logRunFinished() { EEPROM.update(LOG_ACTIVE_ADDR, 0); }

// pack a distance into one byte: 0..250cm, 255 = "no reading / >250"
uint8_t packCm(long d) { return (d >= 250) ? 255 : (uint8_t)d; }

void logTelemetry() {
  static unsigned long lastLogMs = 0;
  unsigned long now = millis();
  if (now - lastLogMs < LOG_PERIOD_MS) return;
  if (logCount >= LOG_MAX_RECS) return;         // full: keep the run's beginning
  lastLogMs = now;

  int addr = LOG_DATA_ADDR + (int)logCount * LOG_REC_SIZE;
  uint16_t t10   = (now - logT0) / 100;         // time since GO, 0.1s steps
  int16_t  yaw10 = (int16_t)(yaw * 10.0);       // yaw in 0.1 deg steps
  EEPROM.put(addr, t10);
  EEPROM.update(addr + 2, (uint8_t)state);
  EEPROM.update(addr + 3, packCm(lastFront));
  EEPROM.update(addr + 4, packCm(lastRight));
  EEPROM.update(addr + 5, packCm(lastLeft));
  EEPROM.put(addr + 6, yaw10);
  EEPROM.update(addr + 8, packVcc());
  uint8_t blk = 0;                       // 0 none / 1 red / 2 green
  uint8_t bx = 0, bsz = 0;
#if OBSTACLE_MODE
  if (blockActive) {
    blk = (blockColorId == HUSKY_ID_RED) ? 1 : 2;
    bx  = (uint8_t)constrain(blockX / 2, 0, 255);   // frame x/2 (0..160)
    bsz = (uint8_t)constrain(blockSize, 0, 255);
  }
#endif
  EEPROM.update(addr + 9,  blk);
  EEPROM.update(addr + 10, bx);
  EEPROM.update(addr + 11, bsz);
  EEPROM.update(addr + 12, (int8_t)constrain((int)lround(centerOffset), -127, 127));  // steer offset applied (deg)

  logCount++;
  EEPROM.put(1, logCount);   // header updated per record so a power cut mid-run loses nothing
}

// Appended at boot when the previous run never finished: marks WHERE in the
// log the board rebooted and stores the hardware reset cause + Vcc at boot.
void logBootMarker(uint8_t resetFlags) {
  if (EEPROM.read(0) != LOG_MAGIC || EEPROM.read(LOG_ACTIVE_ADDR) != 1) return;
  uint16_t n; EEPROM.get(1, n);
  if (n >= LOG_MAX_RECS) return;
  int addr = LOG_DATA_ADDR + (int)n * LOG_REC_SIZE;
  uint16_t z16 = 0; int16_t zy = 0;
  EEPROM.put(addr, z16);
  EEPROM.update(addr + 2, LOG_BOOT_STATE);
  EEPROM.update(addr + 3, resetFlags);          // MCUSR bits at this boot
  EEPROM.update(addr + 4, 0);
  EEPROM.update(addr + 5, 0);
  EEPROM.put(addr + 6, zy);
  EEPROM.update(addr + 8, packVcc());
  EEPROM.update(addr + 9, 0);
  n++; EEPROM.put(1, n);
}

void printResetCause(uint8_t f) {
  if (f & _BV(BORF))  Serial.print(F("BROWN-OUT "));
  if (f & _BV(WDRF))  Serial.print(F("WATCHDOG "));
  if (f & _BV(EXTRF)) Serial.print(F("EXTERNAL-RESET "));
  if (f & _BV(PORF))  Serial.print(F("POWER-ON "));
  if (f == 0)         Serial.print(F("UNKNOWN (bootloader cleared MCUSR - judge by the Vcc column)"));
}

void logDump() {
  if (EEPROM.read(0) != LOG_MAGIC) { Serial.println(F("No run log in EEPROM.")); return; }
  uint16_t n; EEPROM.get(1, n);
  if (n > LOG_MAX_RECS) n = LOG_MAX_RECS;
  Serial.print(F("=== LAST RUN LOG (")); Serial.print(n); Serial.println(F(" records) ==="));
  Serial.println(F("t_s,state,front,right,left,yaw,vcc,blk,blkX,blkSz,steer"));
  for (uint16_t i = 0; i < n; i++) {
    int addr = LOG_DATA_ADDR + (int)i * LOG_REC_SIZE;
    uint16_t t10; int16_t yaw10;
    EEPROM.get(addr, t10);
    uint8_t st  = EEPROM.read(addr + 2);
    uint8_t f   = EEPROM.read(addr + 3);
    uint8_t r   = EEPROM.read(addr + 4);
    uint8_t l   = EEPROM.read(addr + 5);
    EEPROM.get(addr + 6, yaw10);
    uint8_t vcc = EEPROM.read(addr + 8);
    uint8_t blk = EEPROM.read(addr + 9);
    uint8_t bx  = EEPROM.read(addr + 10);
    uint8_t bsz = EEPROM.read(addr + 11);
    int8_t  soff = (int8_t)EEPROM.read(addr + 12);

    if (st == LOG_BOOT_STATE) {
      // the board rebooted here mid-run - f holds the MCUSR reset flags
      Serial.print(F("--- BOOT, cause: ")); printResetCause(f);
      Serial.print(F("  Vcc at boot: ")); Serial.print(vcc * 0.05, 2);
      Serial.println(F("V ---"));
      continue;
    }
    Serial.print(t10 / 10.0, 1);                       Serial.print(',');
    Serial.print(st < 7 ? STATE_NAMES[st] : "?");      Serial.print(',');
    Serial.print(f); Serial.print(',');
    Serial.print(r); Serial.print(',');
    Serial.print(l); Serial.print(',');
    Serial.print(yaw10 / 10.0, 1);                     Serial.print(',');
    Serial.print(vcc * 0.05, 2);                       Serial.print(',');
    Serial.print(blk == 1 ? F("R") : blk == 2 ? F("G") : F("-")); Serial.print(',');
    Serial.print(blk ? bx * 2 : 0);                    Serial.print(',');   // blockX (undo /2)
    Serial.print(bsz);                                 Serial.print(',');
    Serial.println(soff);                                                   // steer offset applied (deg)
  }
  Serial.println(F("=== END LOG ==="));
}

// =====================================================
//                     GYRO (MPU6050)
// =====================================================
void mpuWrite(byte reg, byte val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

int16_t readGyroZraw() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47);                       // GYRO_ZOUT_H
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 2);
  int16_t hi = Wire.read();
  int16_t lo = Wire.read();
  return (hi << 8) | lo;
}

// ---- bias calibration: vehicle MUST be completely still ----
// Runs 5 separate passes and takes the median of them instead of one long
// average, so a bump/vibration during a single pass can't skew the result.
#define GYRO_CAL_PASSES 5
#define GYRO_CAL_SAMPLES_PER_PASS 200   // 5 x 200 = 1000 total samples, same as before

void gyroInit() {
  Wire.begin();
  mpuWrite(0x6B, 0x00);                   // wake up
  mpuWrite(0x1B, 0x08);                   // gyro full scale +/-500 dps
  delay(100);

  float passBias[GYRO_CAL_PASSES];
  for (int pass = 0; pass < GYRO_CAL_PASSES; pass++) {
    long sum = 0;
    for (int i = 0; i < GYRO_CAL_SAMPLES_PER_PASS; i++) {
      sum += readGyroZraw();
      delay(2);
    }
    passBias[pass] = (float)sum / GYRO_CAL_SAMPLES_PER_PASS;
    Serial.print(F("  gyro cal pass ")); Serial.print(pass + 1);
    Serial.print(F("/")); Serial.print(GYRO_CAL_PASSES);
    Serial.print(F(": bias = ")); Serial.println(passBias[pass], 2);
  }

  for (int i = 1; i < GYRO_CAL_PASSES; i++) {  // insertion sort, tiny array
    float key = passBias[i];
    int j = i - 1;
    while (j >= 0 && passBias[j] > key) { passBias[j + 1] = passBias[j]; j--; }
    passBias[j + 1] = key;
  }
  gyroBiasZ = passBias[GYRO_CAL_PASSES / 2];   // median
  Serial.print(F("Gyro bias (median): ")); Serial.println(gyroBiasZ, 2);

  lastGyroMicros = micros();
}

void updateYaw() {
  unsigned long now = micros();
  float dt = (now - lastGyroMicros) / 1000000.0;
  lastGyroMicros = now;

  // +/-500 dps range -> 65.5 LSB per deg/s
  float rate = GYRO_Z_SIGN * (readGyroZraw() - gyroBiasZ) / 65.5;

  // the calibrated bias is never exactly right (and drifts with temperature),
  // so tiny residual noise gets integrated as fake rotation even while going
  // straight - ignore anything below this rate, it isn't a real turn
  if (fabs(rate) < GYRO_RATE_DEADBAND) rate = 0;

  yaw += rate * dt;                       // CCW rotation gives positive yaw
}

// =====================================================
//                     ULTRASONIC
// =====================================================
// One raw ping. Returns -1 for any invalid reading (no echo, or a 0 cm glitch
// below the sensor's real minimum range) so the caller can decide what it means.
long pingOnce(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 20000);   // 20 ms timeout (~3.4 m)
  if (duration == 0) return -1;                    // no echo at all

  long distance = duration * 0.034 / 2;
  if (distance == 0) return -1;                    // 0 cm glitch
  return distance;
}

// Takes several pings and returns their median. Invalid/zero pings are kept
// as "far" (999) rather than thrown away, because a run of them can be a real
// reading (e.g. side sensor sees nothing while cornering) - not just noise.
// With enough samples, a lone spurious ping just gets outvoted by the rest.
// (3 is enough: median-of-3 kills single glitches, and corner triggers also
// need 2 consecutive loops - fewer samples = faster loop = better steering)
#define US_SAMPLES 3

long medianOfSamples(long samples[US_SAMPLES]) {
  long sorted[US_SAMPLES];
  for (int i = 0; i < US_SAMPLES; i++) sorted[i] = samples[i];

  for (int i = 1; i < US_SAMPLES; i++) { // insertion sort, n is tiny
    long key = sorted[i];
    int j = i - 1;
    while (j >= 0 && sorted[j] > key) { sorted[j + 1] = sorted[j]; j--; }
    sorted[j + 1] = key;
  }
  return sorted[US_SAMPLES / 2];          // median
}

// last raw samples per sensor (before the median filter), kept just so we can log them
long lastFrontRaw[US_SAMPLES], lastRightRaw[US_SAMPLES], lastLeftRaw[US_SAMPLES];

// Keep the gyro heading hold alive for `ms` instead of a dead delay().
// A full 3-sensor ultrasonic pass blocks 200-450ms; if the servo just sits
// at the last correction that whole time, the car sweeps far past the target
// heading between updates and weaves down the corridor (proven by flight
// log: TURNING, which never pings, was smooth - RUN oscillated +/-80 deg).
void gyroSteerFor(unsigned long ms) {
  unsigned long t0 = millis();
  do {
    updateYaw();
    steerToHeading(centerOffset);   // centerOffset = wall centering; 0 in turns
  } while (millis() - t0 < ms);
}

// Reads all three ultrasonics in one shot; zero/no-echo readings are already
// filtered out (kept as 999) rather than dropped. Raw samples are stashed in
// lastFrontRaw/lastRightRaw/lastLeftRaw for logging.
void readUltrasonics(long &front, long &right, long &left) {
  for (int i = 0; i < US_SAMPLES; i++) {
    long d = pingOnce(FRONT_TRIG, FRONT_ECHO);
    lastFrontRaw[i] = (d > 0) ? d : 999;
    gyroSteerFor(10);                    // keep steering between pings, never a dead delay
  }
  for (int i = 0; i < US_SAMPLES; i++) {
    long d = pingOnce(RIGHT_TRIG, RIGHT_ECHO);
    lastRightRaw[i] = (d > 0) ? d : 999;
    gyroSteerFor(10);
  }
  for (int i = 0; i < US_SAMPLES; i++) {
    long d = pingOnce(LEFT_TRIG, LEFT_ECHO);
    lastLeftRaw[i] = (d > 0) ? d : 999;
    gyroSteerFor(10);
  }

  front = medianOfSamples(lastFrontRaw);
  right = medianOfSamples(lastRightRaw);
  left  = medianOfSamples(lastLeftRaw);
}

void printOneDistance(long d) {
  if (d >= 999) Serial.print(F("---- "));
  else {
    if (d < 100) Serial.print(' ');
    if (d < 10)  Serial.print(' ');
    Serial.print(d);
    Serial.print(F("cm "));
  }
}

void printRawSamples(const char *label, long samples[US_SAMPLES]) {
  Serial.print(label); Serial.print(F(":["));
  for (int i = 0; i < US_SAMPLES; i++) {
    if (i > 0) Serial.print(',');
    Serial.print(samples[i]);
  }
  Serial.print(F("] "));
}

// Serial-prints current state + ultrasonic + gyro readings, throttled so it
// doesn't flood the port.
void printUltrasonics(long front, long right, long left) {
  static unsigned long lastPrintMs = 0;
  unsigned long now = millis();
  if (now - lastPrintMs < 200) return;
  lastPrintMs = now;

  Serial.print('['); Serial.print(STATE_NAMES[state]); Serial.print(F("] "));

  printRawSamples("F raw", lastFrontRaw);
  printRawSamples("R raw", lastRightRaw);
  printRawSamples("L raw", lastLeftRaw);

  Serial.print(F("| US  F: ")); printOneDistance(front);
  Serial.print(F(" R: "));    printOneDistance(right);
  Serial.print(F(" L: "));    printOneDistance(left);
  Serial.print(F(" | Yaw: "));    Serial.print(yaw, 1);
  Serial.print(F(" Target: "));   Serial.print(targetYaw, 1);
#if OBSTACLE_MODE
  Serial.print(F(" | Blk: "));
  if (blockActive) {
    Serial.print(blockColorId == HUSKY_ID_RED ? 'R' : 'G');
    Serial.print(F(" x=")); Serial.print(blockX);
    Serial.print(F(" sz=")); Serial.print(blockSize);
  } else Serial.print('-');
#endif
  Serial.println();
}

